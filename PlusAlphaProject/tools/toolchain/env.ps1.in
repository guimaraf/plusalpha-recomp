# Toolchain portatil local (NAO versionada). Uso:  . .\tools\env.ps1
# Ajusta SOMENTE variaveis da sessao atual do PowerShell; nada persistente.
$ToolsRoot = $PSScriptRoot
$env:PLUSALPHA_TOOLS_ROOT = $ToolsRoot
$env:PLUSALPHA_MSYS2_ROOT = Join-Path $ToolsRoot 'msys64'
$env:PLUSALPHA_PYTHON     = Join-Path $ToolsRoot 'python\python.exe'
$Ucrt  = Join-Path $env:PLUSALPHA_MSYS2_ROOT 'ucrt64\bin'
$Mingw = Join-Path $env:PLUSALPHA_MSYS2_ROOT 'mingw64\bin'
$env:PSX_MINGW_BIN = $Mingw            # gcc mingw64 usado por compile_overlays.py / testes
$env:PLUSALPHA_UCRT_BIN = $Ucrt
$env:PLUSALPHA_MINGW_BIN = $Mingw
$PyDir = Join-Path $ToolsRoot 'python'
$PyScripts = Join-Path $PyDir 'Scripts'
# retcomm cmake-clang-v1 (clang/cmake/ninja do build do recompilador; copia byte a byte do cache oficial)
$RetcommRoot = Join-Path $ToolsRoot 'retcomm\cmake-clang-v1\1.0.14'
if (Test-Path (Join-Path $RetcommRoot 'bin\clang.exe')) {
    $env:PLUSALPHA_RETCOMM_ROOT = $RetcommRoot
    $env:PLUSALPHA_CLANG = Join-Path $RetcommRoot 'bin\clang.exe'
    $env:PLUSALPHA_CMAKE = Join-Path $RetcommRoot 'bin\cmake.exe'
    $env:PLUSALPHA_NINJA = Join-Path $RetcommRoot 'bin\ninja.exe'
}
# retcomm NAO entra no PATH desta sessao (evita misturar o cmake do retcomm com o do MSYS2); use as variaveis acima.
$env:PATH = "$PyDir;$PyScripts;$Ucrt;$env:PATH"
# TEMP gravavel evita 'Cannot create temporary file in C:\WINDOWS\' quando TEMP/TMP faltam.
if (-not $env:TEMP) { $env:TEMP = Join-Path $ToolsRoot '_tmp'; New-Item -ItemType Directory -Force $env:TEMP | Out-Null }
if (-not $env:TMP)  { $env:TMP = $env:TEMP }
$env:PYTHONUTF8 = '1'
Write-Host "[plusalpha] toolchain portatil ativa: python=$env:PLUSALPHA_PYTHON ucrt=$Ucrt retcomm=$env:PLUSALPHA_RETCOMM_ROOT" -ForegroundColor Cyan
