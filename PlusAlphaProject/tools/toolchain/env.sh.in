# Toolchain portatil local (NAO versionada). Uso:  source tools/env.sh   (Git Bash)
# Ajusta SOMENTE variaveis da sessao atual; nada persistente.
_pa_tools="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PLUSALPHA_TOOLS_ROOT="$_pa_tools"
export PLUSALPHA_MSYS2_ROOT="$_pa_tools/msys64"
export PLUSALPHA_PYTHON="$_pa_tools/python/python.exe"
export PLUSALPHA_UCRT_BIN="$PLUSALPHA_MSYS2_ROOT/ucrt64/bin"
export PLUSALPHA_MINGW_BIN="$PLUSALPHA_MSYS2_ROOT/mingw64/bin"
# PSX_MINGW_BIN em formato Windows (consumido por Python nativo)
export PSX_MINGW_BIN="$(cygpath -w "$PLUSALPHA_MINGW_BIN" 2>/dev/null || echo "$PLUSALPHA_MINGW_BIN")"
# retcomm cmake-clang-v1 (clang/cmake/ninja do build do recompilador); fora do PATH, use as variaveis
_pa_rc="$_pa_tools/retcomm/cmake-clang-v1/1.0.14"
if [ -f "$_pa_rc/bin/clang.exe" ]; then
  export PLUSALPHA_RETCOMM_ROOT="$_pa_rc"
  export PLUSALPHA_CLANG="$_pa_rc/bin/clang.exe"
  export PLUSALPHA_CMAKE="$_pa_rc/bin/cmake.exe"
  export PLUSALPHA_NINJA="$_pa_rc/bin/ninja.exe"
fi
unset _pa_rc
export PATH="$_pa_tools/python:$_pa_tools/python/Scripts:$PLUSALPHA_UCRT_BIN:$PATH"
export PYTHONUTF8=1
unset _pa_tools
echo "[plusalpha] toolchain portatil ativa (sessao atual)"
